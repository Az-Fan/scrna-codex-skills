{
  "project": {
    "id": "project_id"
  },
  "input": {
    "type": "seurat",
    "object": "path/to/annotated_object.qs",
    "assay": "RNA",
    "counts_source": "raw_umi"
  },
  "metadata": {
    "sample": "sample_id",
    "condition": "condition",
    "cell_type": "annotation_fine",
    "batch": "batch_id",
    "donor": null
  },
  "contrast": {
    "numerator": "disease",
    "denominator": "control"
  },
  "preprocessing": {
    "normalization": "raw_counts"
  },
  "augur": {
    "cv_unit": "cell",
    "n_subsamples": 50,
    "subsample_size": 20,
    "folds": 3,
    "feature_perc": 0.5,
    "var_quantile": 0.5,
    "span": 0.75,
    "n_estimators": 100,
    "n_threads": 1,
    "seed": 14,
    "min_replicates_per_condition": 2
  },
  "runtime": {
    "pixi_root": "~/projects/scrna_envs"
  },
  "output": {
    "figure_format": "pdf"
  },
  "output_dir": "results/18_augur_prioritization"
}
